{
  "$schema": "https://www.schemastore.org/prettierrc.json",
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "proseWrap": "preserve",
  "printWidth": 80,

  "plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
  "overrides": [{ "files": "**/*.svelte", "options": { "parser": "svelte" } }],
  "tailwindStylesheet": "./src/app.css"
}
