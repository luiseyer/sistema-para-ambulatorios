{
  "name": "sistema-para-ambulatorio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "biome check . && prettier --check .",
    "format": "biome check --write . && prettier --write ."
  },
  "dependencies": {
    "better-result": "2.10.0",
    "dexie": "4.4.4",
    "drizzle-orm": "1.0.0-rc.4",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@typescript/native": "7.0.2",
    "drizzle-kit": "1.0.0-rc.4",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.56.8",
    "svelte-adapter-bun": "1.0.1",
    "svelte-check": "4.7.4",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6",
    "vite": "8.2.0"
  }
}
